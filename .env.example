# Local demo only. Do not reuse these secrets outside this demo.
# UNLAB_DATA_DIR is the on-disk data directory (SQLite, imports, generated worlds).
# UNLAB_JWT_SECRET signs demo login tokens. Replace it before any non-demo use.
# scripts/start_*.sh and start_*.ps1 also read UNLAB_API_PORT (default 8000)
# and UNLAB_WEB_PORT (default 5173) from the process environment. They bind
# 127.0.0.1 and do not change machine-wide configuration.
UNLAB_DATABASE_URL=sqlite:///./data/urbannoise.db
UNLAB_JWT_SECRET=dev-only-not-for-production-use-32b
UNLAB_JWT_EXP_MINUTES=720
UNLAB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
UNLAB_AUTO_SEED=1
UNLAB_DATA_DIR=./data
UNLAB_LOG_LEVEL=INFO
