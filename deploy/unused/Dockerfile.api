# UNUSED. Not a supported run path. Use scripts/setup_linux.sh or scripts/setup_windows.ps1.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY experiments/configs ./experiments/configs
RUN pip install --no-cache-dir .
ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "urbannoise.api:app", "--host", "0.0.0.0", "--port", "8000"]
